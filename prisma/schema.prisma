generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String
  companyName        String?
  passwordHash       String?
  authProvider       String    @default("EMAIL") // "EMAIL" or "PAYPAL"
  paypalEmail        String?
  paypalClientId     String?
  paypalClientSecret String?
  paypalEnv          String    @default("SANDBOX") // "SANDBOX" or "LIVE"
  defaultCurrency    String    @default("USD")     // "USD", "EUR", or "INR"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  invoices           Invoice[]
  activityLogs       ActivityLog[]

  @@map("users")
}

model Invoice {
  id            String    @id @default(uuid())
  userId        String?
  paypalId      String    @unique
  invoiceNumber String
  customerName  String?
  customerEmail String?
  amount        Decimal   @db.Decimal(10, 2)
  currency      String
  status        String
  issueDate     DateTime
  dueDate       DateTime?
  lastSyncedAt  DateTime  @default(now())
  source        String    // "PAYPAL_SANDBOX" or "DEMO"
  rawStatus     String?

  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  proposals     ActionProposal[]
  activityLogs  ActivityLog[]

  @@map("invoices")
}

model ActionProposal {
  id              String    @id @default(uuid())
  invoiceId       String
  actionType      String    // e.g., "SEND_REMINDER"
  proposedMessage String    @db.Text
  aiExplanation   String    @db.Text
  priority        Decimal   @db.Decimal(5, 2)
  state           String    // "PENDING", "APPROVED", "REJECTED", "EXECUTING", "EXECUTED", "FAILED"
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?
  executedAt      DateTime?
  paypalReference String?
  idempotencyKey  String    @unique @default(uuid())

  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  activityLogs    ActivityLog[]

  @@map("action_proposals")
}

model ActivityLog {
  id          String    @id @default(uuid())
  userId      String?
  invoiceId   String?
  proposalId  String?
  eventType   String
  status      String
  description String    @db.Text
  metadata    Json?
  createdAt   DateTime  @default(now())

  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoice     Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  proposal    ActionProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}